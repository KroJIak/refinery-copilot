# Refinery Copilot local and Docker configuration.
# Copy to .env before Docker Compose: cp .env.example .env

# Reproducibility
SEED=42

# Local paths. Docker Compose replaces them with /app/data and /app/artifacts.
DATA_DIR=data
ARTIFACTS_DIR=artifacts
MODEL_REGISTRY_DIR=artifacts/models

# Advisory narration. The standard delivery works offline without an LLM.
LLM_MODE=off
LLM_BASE_URL=
LLM_MODEL=

# Local development and Compose ports
API_PORT=8000
VITE_PORT=5173
EXTERNAL_API_PORT=8000
EXTERNAL_WEB_PORT=8080

# Browser-to-API configuration for Vite development
VITE_USE_MOCKS=false
VITE_API_BASE=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000
BACKEND_URL=http://api:8000

# Browser origins allowed by the FastAPI service in local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
