# «Refinery Copilot» — шаблон окружения. Скопируйте: cp .env.example .env
# Секретов в репо нет; .env не коммитится.

# --- Воспроизводимость ---
SEED=42

# --- Пути ---
DATA_DIR=data
ARTIFACTS_DIR=artifacts
MODEL_REGISTRY_DIR=artifacts/models

# --- Сервис и логи ---
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=8080
VITE_PORT=5173

# --- LLM-слой ---
LLM_MODE=off
LLM_BASE_URL=
LLM_MODEL=

# --- Фронтенд ---
# true — фикстуры, backend не нужен
# false — nginx проксирует /api на BACKEND_URL (из контейнера web, обычно http://api:8000)
VITE_USE_MOCKS=true
BACKEND_URL=http://api:8000
